<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarCalls"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#075E54"
        android:title="WAPP Calls"
        android:titleTextColor="@android:color/white" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Llamadas de Voz y Video Seguras"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#075E54"
        android:padding="16dp" />

    <Button
        android:id="@+id/btnStartVoiceCall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar Llamada de Voz"
        android:backgroundTint="#075E54"
        android:textColor="@android:color/white"
        android:layout_margin="16dp" />

    <Button
        android:id="@+id/btnStartVideoCall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar Videollamada HD"
        android:backgroundTint="#128C7E"
        android:textColor="@android:color/white"
        android:layout_marginHorizontal="16dp" />

</LinearLayout>
