<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarAutomations"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#075E54"
        android:title="WAPP Automations"
        android:titleTextColor="@android:color/white" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Automatización Determinista de Mensajes"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#075E54"
        android:padding="16dp" />

    <Switch
        android:id="@+id/switchAutoReply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activar Respuesta Automática (Fuera de horario / Urgentes)"
        android:textSize="16sp"
        android:padding="16dp" />

    <EditText
        android:id="@+id/etAutoReplyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mensaje automático personalizado"
        android:text="Hola, estoy ocupado en este momento. Te responderé pronto."
        android:padding="16dp" />

    <Button
        android:id="@+id/btnSaveAutomation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar Reglas"
        android:backgroundTint="#075E54"
        android:textColor="@android:color/white"
        android:layout_margin="16dp" />

</LinearLayout>
